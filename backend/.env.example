DATABASE_URL=postgresql://postgres:your-password@localhost:5432/research_assistant

# AI editor assistant (OpenAI-compatible chat completions API)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional comma-separated failover models (Gemini defaults to 3.7 and 3.6 Flash)
# LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Password-reset and collaboration email delivery
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# For Gmail, use a Google App Password when 2-Step Verification is enabled.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Keep disabled: reset links are sensitive and must not be saved as raw .eml files.
SAVE_SENT_EMAILS=false